# Copy this file to .env only if your shell tooling loads it. Never commit .env.
GOOGLE_SPREADSHEET_ID=
RESEARCH_RADAR_SHEETS_ENV=test
RESEARCH_RADAR_DATA_MODE=synthetic

# Milestone 4C.1 live previews use a separate workbook only. Leave empty for an
# entirely offline preview. Never point this at the synthetic TEST workbook.
GOOGLE_LIVE_PILOT_SPREADSHEET_ID=

# Optional installed-app OAuth fallback. Prefer Application Default Credentials.
GOOGLE_OAUTH_CLIENT_SECRET_FILE=
GOOGLE_OAUTH_TOKEN_FILE=

# Opt in to the read-only live integration test only after authentication is configured.
RUN_GOOGLE_SHEETS_LIVE_TEST=0
